# AI Stock Platform — Environment Configuration
# Copy this file to .env and fill in your values.
# HARD RULE: The application will fail at startup if SECRET_KEY or TOKEN_ENCRYPTION_SECRET is missing.

# Security Secrets (REQUIRED)
SECRET_KEY=generate_a_long_random_secret_key_for_jwt_signing_here
TOKEN_ENCRYPTION_SECRET=generate_a_32_byte_random_secret_for_token_encryption_here
CRON_SECRET=generate_a_random_cron_secret_for_scheduled_jobs_here

# App & Environment
DEMO_MODE=false
NEXT_PUBLIC_DEMO_MODE=false
CORS_ORIGINS=http://localhost:3000

# Market Data APIs (Optional)
FINNHUB_API_KEY=
TWELVEDATA_API_KEY=
ALPHA_VANTAGE_API_KEY=

# Indian Broker APIs (Zerodha Kite)
ZERODHA_API_KEY=
ZERODHA_API_SECRET=
KITE_API_KEY=
KITE_API_SECRET=
KITE_SANDBOX=false
UPSTOX_API_KEY=
UPSTOX_API_SECRET=

# AI Services — NVIDIA Nemotron (server-side only; NEVER put in NEXT_PUBLIC_*)
NVIDIA_API_KEY=
NVIDIA_MODEL=nvidia/nemotron-3-super-120b-a12b
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

# Database
DATABASE_URL=sqlite:///./ai_stock.db
REDIS_URL=redis://localhost:6379/0

# Backend
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# Frontend (browser-safe — do NOT put AI keys or backend secrets here)
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000/ws
