# AI Stock Platform — Environment Configuration
# Copy this file to .env and fill in your values.

# Market Data APIs
FINNHUB_API_KEY=
TWELVEDATA_API_KEY=
ALPHA_VANTAGE_API_KEY=

# Indian Broker APIs
ZERODHA_API_KEY=
ZERODHA_API_SECRET=
UPSTOX_API_KEY=
UPSTOX_API_SECRET=

# AI Services — NVIDIA Nemotron (server-side only; NEVER put in NEXT_PUBLIC_*)
NVIDIA_API_KEY=
NVIDIA_MODEL=nvidia/nemotron-3-super-120b-a12b
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

# Database
DATABASE_URL=postgresql://postgres:password@localhost:5432/ai_stock_platform
REDIS_URL=redis://localhost:6379/0

# Backend
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
CORS_ORIGINS=http://localhost:3000

# Frontend (browser-safe — do NOT put AI keys here)
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000/ws
