# Backend Environment Configuration (Copy to backend/.env — NEVER commit real secrets)
APP_ENV=development
DEMO_MODE=false
KITE_SANDBOX=false
KITE_WS_ENABLED=false

# Required secrets (application refuses startup if missing)
SECRET_KEY=replace_with_high_entropy_32plus_char_jwt_secret
TOKEN_ENCRYPTION_SECRET=replace_with_32plus_char_aes256_secret
CRON_SECRET=replace_with_high_entropy_cron_secret

# Persistence & Shared Redis Cache / Rate-Limit / WS Tick Store
DATABASE_URL=postgresql+asyncpg://user:pass@localhost:5432/aistock
REDIS_URL=redis://localhost:6379/0

# CORS (explicit origins only, comma-separated)
ALLOWED_ORIGINS=http://localhost:3000

# Live Feed & Research Controls
FEED_QUOTE_MAX_AGE_SECONDS=60
RESEARCH_RATE_LIMIT_PER_MINUTE=30

# Broker (Server-side only)
ZERODHA_API_KEY=
ZERODHA_API_SECRET=

# Optional Research & LLM Keys (Server-side only)
ALPHA_VANTAGE_API_KEY=
ALPHA_VANTAGE_TIER=free
TWELVE_DATA_API_KEY=
TWELVE_DATA_TIER=free
GNEWS_API_KEY=
NVIDIA_API_KEY=

